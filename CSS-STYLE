*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial, sans-serif;
  background:#f8fafc;
  color:#0f172a;
}

header{
  position:fixed;
  width:100%;
  top:0;
  background:white;
  border-bottom:1px solid #e2e8f0;
}

.navbar{
  max-width:1200px;
  margin:auto;
  padding:20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:1.5rem;
  font-weight:bold;
}

.logo span{
  color:#2563eb;
}

.nav-links{
  display:flex;
  gap:20px;
  list-style:none;
}

.nav-links a{
  text-decoration:none;
  color:#0f172a;
}

.btn{
  background:#2563eb;
  color:white;
  padding:12px 20px;
  border-radius:10px;
  text-decoration:none;
}

.hero{
  min-height:100vh;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:40px;
  max-width:1200px;
  margin:auto;
  padding:140px 20px;
}

.hero-text h1{
  font-size:4rem;
  margin-bottom:20px;
}

.hero-text p{
  margin-bottom:20px;
  color:#64748b;
}

.hero-image img{
  width:100%;
  border-radius:20px;
}

.dashboard{
  max-width:1200px;
  margin:auto;
  padding:80px 20px;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.dashboard-card{
  background:white;
  padding:30px;
  border-radius:20px;
  box-shadow:0 10px 30px rgba(0,0,0,.08);
}

footer{
  text-align:center;
  padding:40px;
  background:#0f172a;
  color:white;
}
